27, "type": "bold"}, {"offset": 165, "length": 27, "type": "underline"}]}}}
{"captured_at": "2026-05-27T16:54:40.046003+09:00", "fetch_offset": 800801516, "update_id": 800801525, "top_level_keys": ["message", "update_id"], "chat_id": 6746975543, "chat_type": "private", "message_id": 1094, "message_date_local": "2026-05-27T09:32:21+09:00", "sender_id": 6746975543, "payload": {"update_id": 800801525, "message": {"message_id": 1094, "from": {"id": 6746975543, "is_bot": false, "first_name": "CMS", "username": "mmiinnseok", "language_code": "ko"}, "chat": {"id": 6746975543, "first_name": "CMS", "username": "mmiinnseok", "type": "private"}, "date": 1779841941, "reply_to_message": {"message_id": 1093, "from": {"id": 6746975543, "is_bot": false, "first_name": "CMS", "username": "mmiinnseok", "language_code": "ko"}, "chat": {"id": 6746975543, "first_name": "CMS", "username": "mmiinnseok", "type": "private"}, "date": 1779841564, "forward_origin": {"type": "channel", "chat": {"id": -1002209162616, "title": "준기장", "username": "bearb_0423junsl", "type": "channel"}, "message_id": 6687, "date": 1779786913}, "forward_from_chat": {"id": -1002209162616, "title": "준기장", "username": "bearb_0423junsl", "type": "channel"}, "forward_from_message_id": 6687, "forward_date": 1779786913, "photo": [{"file_id": "AgACAgUAAxkBAAIERWoWOhyiRurkVy3lnVs8hFu9cJGnAALMD2sbNCqpVMoRJ1IIBWZXAQADAgADcwADOwQ", "file_unique_id": "AQADzA9rGzQqqVR4", "file_size": 1715, "width": 85, "height": 90}, {"file_id": "AgACAgUAAxkBAAIERWoWOhyiRurkVy3lnVs8hFu9cJGnAALMD2sbNCqpVMoRJ1IIBWZXAQADAgADbQADOwQ", "file_unique_id": "AQADzA9rGzQqqVRy", "file_size": 36516, "width": 303, "height": 320}, {"file_id": "AgACAgUAAxkBAAIERWoWOhyiRurkVy3lnVs8hFu9cJGnAALMD2sbNCqpVMoRJ1IIBWZXAQADAgADeAADOwQ", "file_unique_id": "AQADzA9rGzQqqVR9", "file_size": 161426, "width": 757, "height": 800}, {"file_id": "AgACAgUAAxkBAAIERWoWOhyiRurkVy3lnVs8hFu9cJGnAALMD2sbNCqpVMoRJ1IIBWZXAQADAgADeQADOwQ", "file_unique_id": "AQADzA9rGzQqqVR-", "file_size": 226922, "width": 1067, "height": 1128}], "caption": "SEDG, ENPH SST Re-rating?\nDC향과 입력/출력 전압, 소자, 변압 방식 모두 다름\n신뢰성 검증이 안된 상태 + 핵심이자 병목인 전력반도체 내재화 X\nENPH의 경우, PCB/전력반도체 전부 외부 조달 후 실장/조립/테스트만 가능\n= SST 제조업체보다는 Assembly 수준\n기술적 격차 이전에 기업의 체질 자체가 다른 영역", "caption_entities": [{"offset": 0, "length": 25, "type": "bold"}, {"offset": 165, "length": 27, "type": "bold"}, {"offset": 165, "length": 27, "type": "underline"}]}, "text": "• IQ SST: 중전압 AC를 저전압 DC로 한번에 직접 변환하도록 설계된 변압기\n• 기존 전력망: 중전압 AC -> 저전압 AC -> UPS-> PDU -> 랙 전원 공급장치 -> 서버용 DC\n• IQ SST는 중전압 AC를 바로 800V DC로 AI 랙에 공급\n• GaN 기반 고주파 전력변환, ASIC 제어 칩,  전력모듈등의 기술이 필요함\n• 전력 밀도가 높아지는 AIDC -> 전력 변환 단계를 줄여 공간, 효율을 개선\n• Enphase: 태양광 마이크로 인버터 회사로 기존의 전력 변환을 응용하여 SST를 만들겠다는 TAM 확장 내러티브"}}}
