로는 #주성엔지니어링 #원익IPS #HPSP #한솔케미칼 #유진테크 #솔브레인 #티씨케이 7개가 있습니다. 둘 중 한 개에 포함된 종목으로는 #테스 #브이엠 #동진쎄미켐 #한미반도체 #이수페타시스 #리노공업 #이오테크닉스 #SKC #심텍 #하나마이크론 #ISC #테크윙 등이 있습니다. 소부장을 매수할 거라면 이 안에서 찾는 전략을 생각해볼 수 있겠습니다.", "caption_entities": [{"offset": 1, "length": 28, "type": "bold"}, {"offset": 256, "length": 4, "type": "bold"}, {"offset": 279, "length": 4, "type": "bold"}, {"offset": 328, "length": 24, "type": "bold"}, {"offset": 475, "length": 8, "type": "hashtag"}, {"offset": 484, "length": 6, "type": "hashtag"}, {"offset": 491, "length": 5, "type": "hashtag"}, {"offset": 497, "length": 6, "type": "hashtag"}, {"offset": 504, "length": 5, "type": "hashtag"}, {"offset": 510, "length": 5, "type": "hashtag"}, {"offset": 516, "length": 5, "type": "hashtag"}, {"offset": 551, "length": 3, "type": "hashtag"}, {"offset": 555, "length": 4, "type": "hashtag"}, {"offset": 560, "length": 6, "type": "hashtag"}, {"offset": 567, "length": 6, "type": "hashtag"}, {"offset": 574, "length": 7, "type": "hashtag"}, {"offset": 582, "length": 5, "type": "hashtag"}, {"offset": 588, "length": 7, "type": "hashtag"}, {"offset": 596, "length": 4, "type": "hashtag"}, {"offset": 601, "length": 3, "type": "hashtag"}, {"offset": 605, "length": 7, "type": "hashtag"}, {"offset": 613, "length": 4, "type": "hashtag"}, {"offset": 618, "length": 4, "type": "hashtag"}]}}}
